  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\CentralOrchestrator\CentralOrchestrator.csproj" />
    <ProjectReference Include="..\..\Common\Contracts\CommonContracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
