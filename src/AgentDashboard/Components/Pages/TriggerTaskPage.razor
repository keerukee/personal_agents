@page "/trigger"
@rendermode InteractiveServer
@inject HttpClient Http

<PageTitle>Trigger Event - Agent Dashboard</PageTitle>

<div class="mb-4">
    <h2 class="fw-bold mb-1"><i class="bi bi-play-circle-fill text-success me-2"></i>Trigger DB Event / Test Prompt</h2>
    <p class="text-muted mb-0">Enqueues a prompt directly into Microsoft SQL Server <code>InboundEvents</code> table for asynchronous orchestration.</p>
</div>

<div class="row">
    <div class="col-lg-5 mb-4">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <h5 class="fw-bold mb-3">Submit Disconnected DB Prompt</h5>
                
                <div class="mb-3">
                    <label class="form-label fw-semibold">Event Source</label>
                    <input type="text" class="form-control" @bind="eventSource" placeholder="BlazorDashboardUser" />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">User Prompt / Instructions</label>
                    <textarea class="form-control" rows="4" @bind="promptText" placeholder="e.g. Run sales database query for July 2026 and format report"></textarea>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Extra JSON Data</label>
                    <textarea class="form-control font-monospace fs-7" rows="3" @bind="jsonData" placeholder='{"subject": "Sales Analysis"}'></textarea>
                </div>

                <button class="btn btn-success w-100 py-2 d-flex align-items-center justify-content-center gap-2" @onclick="SubmitEvent" disabled="@isSubmitting">
                    @if (isSubmitting)
                    {
                        <span class="spinner-border spinner-border-sm" role="status"></span>
                        <span>Enqueuing to SQL Server...</span>
                    }
                    else
                    {
                        <i class="bi bi-database-fill-add"></i>
                        <span>Enqueue Event into SQL Server</span>
                    }
                </button>
            </div>
        </div>
    </div>

    <div class="col-lg-7 mb-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <h5 class="fw-bold mb-0">Live Database Event & Task Progression</h5>
                @if (activeEventGuid != null)
                {
                    <button class="btn btn-sm btn-outline-primary" @onclick="PollEventTasks">
                        <i class="bi bi-arrow-clockwise"></i> Refresh Tasks
                    </button>
                }
            </div>
            <div class="card-body">
                @if (activeEventGuid == null)
                {
                    <div class="text-center py-5 text-muted">
                        <i class="bi bi-database display-4 d-block mb-2"></i>
                        <span>Enqueue an event to observe live SQL Server task queue progression.</span>
                    </div>
                }
                else
                {
                    <div class="alert alert-info d-flex justify-content-between align-items-center mb-3">
                        <div>
                            <strong>Active Event Guid:</strong> <code>@activeEventGuid</code><br />
                            <small>Source: @eventSource</small>
                        </div>
                        <span class="badge bg-primary">Event Status: Active</span>
                    </div>

                    <h6 class="fw-bold mb-2">Queued Agent Tasks (SQL Server `AgentTasks`):</h6>
                    @if (eventTasks == null || eventTasks.Count == 0)
                    {
                        <div class="p-3 text-center text-muted bg-light rounded">
                            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                            Central Orchestrator worker is decomposing event into sub-agent DB tasks...
                        </div>
                    }
                    else
                    {
                        <div class="list-group">
                            @foreach (var task in eventTasks)
                            {
                                <div class="list-group-item p-3 mb-2 rounded border-start border-4 @GetStepBorderClass(task.Status)">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <span class="fw-bold">Step #@task.StepOrder: <code>@task.Action</code></span>
                                        <span class="badge @GetStatusBadgeClass(task.Status)">@task.Status</span>
                                    </div>
                                    <small class="text-muted d-block mb-1">Assigned Agent: <strong>@task.TargetAgentId</strong> | Task Guid: <code>@task.TaskGuid[..8]</code></small>
                                    @if (!string.IsNullOrEmpty(task.ResultJson))
                                    {
                                        <div class="bg-light p-2 rounded fs-7 font-monospace text-wrap mt-2">
                                            <strong>Result:</strong> @task.ResultJson
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</div>

@code {
    private string eventSource = "BlazorDashboardUser";
    private string promptText = "Run sales database query for July 2026 and format report";
    private string jsonData = "{\"subject\": \"Q3 Sales Analysis\"}";
    private bool isSubmitting = false;
    private string? activeEventGuid;
    private List<AgentTaskDto>? eventTasks;

    private async Task SubmitEvent()
    {
        if (string.IsNullOrWhiteSpace(promptText)) return;

        isSubmitting = true;
        activeEventGuid = null;
        eventTasks = null;

        try
        {
            var req = new CreateInboundEventRequest(
                Source: eventSource,
                Prompt: promptText,
                DataJson: jsonData
            );

            var res = await Http.PostAsJsonAsync("api/events/enqueue", req);
            if (res.IsSuccessStatusCode)
            {
                var eventDto = await res.Content.ReadFromJsonAsync<InboundEventDto>();
                if (eventDto != null)
                {
                    activeEventGuid = eventDto.EventGuid;
                    await PollEventTasks();
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error enqueuing event: {ex.Message}");
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task PollEventTasks()
    {
        if (activeEventGuid == null) return;
        try
        {
            eventTasks = await Http.GetFromJsonAsync<List<AgentTaskDto>>($"api/events/queue/{activeEventGuid}/tasks");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error polling tasks: {ex.Message}");
        }
    }

    private static string GetStatusBadgeClass(string status) => status switch
    {
        "Completed" => "bg-success",
        "InProgress" => "bg-info text-dark",
        "Failed" => "bg-danger",
        _ => "bg-warning text-dark"
    };

    private static string GetStepBorderClass(string status) => status switch
    {
        "Completed" => "border-success",
        "InProgress" => "border-info",
        "Failed" => "border-danger",
        _ => "border-warning"
    };
}
